# Android Production Keystore Configuration Example
# Copy this file to 'android/key.properties' and fill in your confidential release credentials.
# NOTE: Never commit 'key.properties' or '*.jks' to Git version control.

storePassword=YOUR_SECURE_STORE_PASSWORD
keyPassword=YOUR_SECURE_KEY_PASSWORD
keyAlias=expedient-release
storeFile=../release-key.jks
